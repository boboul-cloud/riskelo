    "Le dé est remplacé par une question.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The die is replaced by a question."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dé est remplacé par une question."
          }
        }
      }
    },
    "Le dé est remplacé par une question.\nL'attaquant choisit le terrain, le défenseur répond.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The die is replaced by a question.\nThe attacker picks the ground, the defender answers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dé est remplacé par une question.\nL'attaquant choisit le terrain, le défenseur répond."
          }
        }
      }
    },
    "Le dé est remplacé par une question.\nLes deux la reçoivent : le plus sûr, ou le plus vif, l'emporte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The die is replaced by a question.\nBoth receive it: the surer, or the quicker, wins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dé est remplacé par une question.\nLes deux la reçoivent : le plus sûr, ou le plus vif, l'emporte."
          }
        }
      }
    },
    "Le défenseur": {
      "localizations": {
