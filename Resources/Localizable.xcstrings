    "Vos amis Game Center, ou quelqu'un au hasard. Apple s'occupe de vous mettre en présence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Game Center friends, or somebody at random. Apple takes care of bringing you together."
          }
        }
      }
