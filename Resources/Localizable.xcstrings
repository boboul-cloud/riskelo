    " *Remplie.*": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " *Filled.*"
          }
        }
      }
    },
    "%@ %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld"
          }
        }
      }
    },
    "%@ a envoyé une partie que cet appareil ne sait pas lire. Installez la même version de Riskelo sur les deux, puis recommencez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sent a game this device cannot read. Install the same version of Riskelo on both, then start again."
          }
        }
      }
    },
    "%@ a répondu. À vous la même question.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has answered. The same question is yours."
          }
        }
      }
    },
    "%@ attaque": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ attacks"
          }
        }
      }
    },
