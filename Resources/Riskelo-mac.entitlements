<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Le bac à sable : l'application est enfermée dans son propre dossier et
	     ne voit rien du reste du Mac. Le Mac App Store l'exige, sans exception.
	     Sur iPhone et iPad, il est posé d'office par le système — c'est
	     pourquoi ce fichier ne sert qu'à macOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Le bac à sable coupe le réseau avec le reste. Ces deux clés le
	     rouvrent, et seulement lui : sortir pour trouver l'autre appareil,
	     et se laisser trouver par lui. Sans elles, le Mac et l'iPhone ne se
	     verraient plus — et rien à l'écran ne dirait pourquoi. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
