    },
    "Les deux savaient. %@ a été le plus vif : %@ tient, l'assaillant laisse %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both knew. %@ was quicker: %@ holds, the attacker leaves %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux savaient. %@ a été le plus vif : %@ tient, l'assaillant laisse %@."
          }
        }
      }
    },
    "Les deux savent : le sablier tranche. Aucun des deux : la place tient, comme sur une égalité de dés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both know: the clock settles it. Neither of them: the place holds, as on a tie of dice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux savent : le sablier tranche. Aucun des deux : la place tient, comme sur une égalité de dés."
          }
        }
      }
    },
