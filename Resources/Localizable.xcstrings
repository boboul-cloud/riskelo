    "L'autre appareil a envoyé une partie que celui-ci ne sait pas lire. Installez la même version de Riskelo des deux côtés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device sent a game this one cannot read. Install the same version of Riskelo on both sides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre appareil a envoyé une partie que celui-ci ne sait pas lire. Installez la même version de Riskelo des deux côtés."
          }
        }
      }
    },
    "LE MÊME CODE QUE L'AUTRE SOIR": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THE SAME CODE AS LAST TIME"
          }
        }
      }
    },
    "La conquête de %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s conquest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conquête de %@"
          }
        }
      }
    },
    "La liaison est bonne : c'est la partie qui n'arrive pas. Celui qui l'a ouverte doit être là lui aussi, et toucher « Reprendre la partie ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is good: it is the game that is not arriving. Whoever opened it has to be there too, and tap “Resume the game”."
          }
        }
      }
    },
    "La liaison est bonne : c'est le lancement qui n'arrive pas. Celui qui a ouvert la partie doit toucher « Commencer ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is good: it is the launch that is not arriving. Whoever opened the game has to tap “Start”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liaison est bonne : c'est le lancement qui n'arrive pas. Celui qui a ouvert la partie doit toucher « Commencer »."
          }
        }
      }
    },
    "La liaison est bonne : c'est le lancement qui n'arrive pas. Vérifiez que %@ a bien touché « Commencer », et que les deux appareils ont la même version de Riskelo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is good: it is the launch that is not arriving. Check that %@ really tapped “Start”, and that both devices have the same version of Riskelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liaison est bonne : c'est le lancement qui n'arrive pas. Vérifiez que %@ a bien touché « Commencer », et que les deux appareils ont la même version de Riskelo."
          }
        }
      }
    },
    "La liaison est tombée": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link dropped"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liaison est tombée"
          }
        }
      }
    },
